---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site, categories as cats } from '@/config';
import { formatDate, readingTime } from '@/utils';
import { useTranslations } from '@/i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const { data } = post;
const lang = data.lang;
const t = useTranslations(lang);
const catName = cats[lang].find((c) => c.slug === data.category)?.name ?? data.category;
const mins = readingTime(post.body);
const url = new URL(`/blog/${post.slug}/`, site.url).href;

// Gợi ý bài cùng chủ đề (cùng category + cùng ngôn ngữ), loại bài hiện tại, tối đa 3, ưu tiên mới nhất.
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
let related = allPosts
  .filter((p) => p.data.lang === lang && p.data.category === data.category && p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// Fallback: nếu cùng category chưa đủ 3, bù thêm bài mới nhất cùng ngôn ngữ.
if (related.length < 3) {
  const extra = allPosts
    .filter((p) => p.data.lang === lang && p.slug !== post.slug && !related.some((r) => r.slug === p.slug))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  related = related.concat(extra);
}
related = related.slice(0, 3);

// Link share mạng xã hội.
const shareText = encodeURIComponent(data.title);
const shareUrl = encodeURIComponent(url);
const share = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`,
  x: `https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`,
  telegram: `https://t.me/share/url?url=${shareUrl}&text=${shareText}`,
};
---
<BaseLayout title={data.title} description={data.description} image={data.cover} type="article">
  <article class="article container">
    <a href="/blog" class="back-link">← {lang === 'en' ? 'Back to Blog' : 'Quay lại Blog'}</a>
    <div class="meta" style="color:var(--accent2);font-size:0.85rem;">{catName}</div>
    <h1>{data.title}</h1>
    <div class="article-meta">
      {formatDate(data.pubDate, lang)} · {mins} {t('blog.readingTime')}
    </div>
    {data.cover && (
      <img class="article-hero" src={data.cover} alt={data.title} width="1200" height="675" loading="eager" decoding="async" />
    )}
    <div class="prose">
      <Content />
    </div>

    <div class="share">
      <span class="share-label">{lang === 'en' ? 'Share:' : 'Chia sẻ:'}</span>
      <a class="share-btn" href={share.facebook} target="_blank" rel="noopener">Facebook</a>
      <a class="share-btn" href={share.x} target="_blank" rel="noopener">X</a>
      <a class="share-btn" href={share.telegram} target="_blank" rel="noopener">Telegram</a>
    </div>

    {related.length > 0 && (
      <section class="related">
        <h2>{lang === 'en' ? 'Related articles' : 'Bài viết cùng chủ đề'}</h2>
        <div class="related-grid">
          {related.map((p) => (
            <a class="related-card" href={`/blog/${p.slug}/`}>
              {p.data.cover && <img class="related-img" src={p.data.cover} alt={p.data.title} width="400" height="225" loading="lazy" decoding="async" />}
              <div class="related-body">
                <span class="related-cat">{cats[p.data.lang].find((c) => c.slug === p.data.category)?.name ?? p.data.category}</span>
                <h3>{p.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .back-link { display: inline-block; margin-bottom: 1rem; color: var(--accent2); font-size: 0.9rem; }
  .back-link:hover { text-decoration: underline; }
  .share {
    display: flex; align-items: center; flex-wrap: wrap; gap: 10px;
    margin: 2rem 0; padding: 1rem 0;
    border-top: 1px solid var(--border, #e5e5e5);
    border-bottom: 1px solid var(--border, #e5e5e5);
  }
  .share-label { font-weight: 600; color: var(--muted, #666); }
  .share-btn {
    display: inline-block; padding: 6px 14px; border-radius: 999px;
    font-size: 0.9rem; font-weight: 600;
    border: 1.5px solid var(--accent2, #6d28d9); color: var(--accent2, #6d28d9);
    transition: all 0.2s;
  }
  .share-btn:hover { background: var(--accent2, #6d28d9); color: #fff; transform: translateY(-2px); }
  .related { margin-top: 3rem; }
  .related h2 { margin-bottom: 1.2rem; }
  .related-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.2rem;
  }
  .related-card {
    display: block; background: var(--card, #fff);
    border: 1px solid var(--border, #e5e5e5); border-radius: 12px; overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .related-card:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(0,0,0,0.08); }
  .related-img { width: 100%; height: auto; display: block; }
  .related-body { padding: 0.9rem 1rem 1.1rem; }
  .related-cat { font-size: 0.8rem; color: var(--accent2, #6d28d9); font-weight: 600; }
  .related-body h3 { font-size: 1rem; margin: 0.3rem 0 0; line-height: 1.4; }
</style>
 margin: 0.3rem 0 0; line-height: 1.4; }
</style>
